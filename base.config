params {
    out_dir = "output"
    wf {
        // container sha
        e2l_base_tag = "sha8ecee6d351b0c2609b452f3a368c390587f6662d"
        e2l_snp_tag = "shabd38f7cf45346fc8601b77ed075e3e1b9f7cd506"
        e2l_sv_tag = "sha8134f9fef5e19605c7fb4c1348961d6771f1af79"
        e2l_mod_tag = "sha489d708a48c66368e5d1e118538e5dca68203a64"
        cnv_tag = "sha428cb19e51370020ccf29ec2af4eead44c6a17c2"
        str_tag = "shadd2f2963fe39351d4e0d6fa3ca54e1064c6ec057"
        spectre_tag = "sha42472d37a5a992c3ee27894a23dce5e2fff66d27"
        vep_tag = "release_116.0"
        annotsv_tag = "3.5.10"
        cnv_ensemble_tag = "1.0.0"
        tldr_tag = "1.2.2"
        tapes_tag = "fixed"
        dmr_analysis_tag = "v1.0"
        dmr_report_tag = "0.13.2"
        modbamtools_tag = "v0.4.8"
        methylartist_tag = "v1.5.2"
        common_sha = "shafdd79f8e4a6faad77513c36f623693977b92b08e"
        longphase_tag = "sha4ff1cd9a6eee338a414082cb24f943bcc4ce8e7c" 
    }
}

// used by default for "standard" (docker) and singularity profiles,
// other profiles may override.
process {
    container = "ontresearch/wf-human-variation:${params.wf.e2l_base_tag}"
    withLabel:wf_human_snp {
        container = "ontresearch/wf-human-variation-snp:${params.wf.e2l_snp_tag}"
    }
    withLabel:wf_human_sv {
        container = "ontresearch/wf-human-variation-sv:${params.wf.e2l_sv_tag}"
    }
    withLabel:wf_human_mod {
        container = "ontresearch/modkit:${params.wf.e2l_mod_tag}"
    }
    withLabel:wf_cnv {
        container = "ontresearch/wf-cnv:${params.wf.cnv_tag}"
    }
    withLabel:wf_human_str {
        container = "ontresearch/wf-human-variation-str:${params.wf.str_tag}"
    }
    withLabel:vep_annotation {
        container = "ensemblorg/ensembl-vep:${params.wf.vep_tag}"
    }
    withLabel:annotsv {
        // no official AnnotSV image exists -- this is our own, built from
        // docker/annotsv/Dockerfile and pushed to a personal Docker Hub
        // account (see that file for the build/push commands). Hardcoded
        // (not a params.* like vep_image would be) for the same reason
        // ensembl-vep is hardcoded above: pull rate limits on Docker Hub are
        // keyed to whoever is *pulling*, not to the account that published
        // the image, so there's no benefit to making the namespace a
        // separately-configurable param here.
        container = "romualdomf/annotsv:${params.wf.annotsv_tag}"
    }
    withLabel:cnv_ensemble {
        // ISV (tsladecek/isv_package) + ClassifyCNV (Genotek/ClassifyCNV)
        // combined into one image -- see docker/cnv_ensemble/Dockerfile for
        // why they're bundled together instead of split, and
        // scripts/cnv_ensemble_classify.py for what actually runs in it.
        // Same hardcoding rationale as withLabel:annotsv above.
        container = "romualdomf/cnv-ensemble:${params.wf.cnv_ensemble_tag}"
    }
    withLabel:tldr {
        // no official tldr image exists -- this is our own, built from
        // docker/tldr/Dockerfile (see that file for what's bundled and why:
        // minimap2/samtools/mafft/exonerate/tabix are all real runtime
        // dependencies of tldr's own algorithm, not just of upstream
        // alignment). Same hardcoding rationale as withLabel:annotsv above.
        container = "romualdomf/tldr:${params.wf.tldr_tag}"
    }
    withLabel:tapes {
        // ACMG/AMP variant classification on top of the VEP-annotated SNP VCF (see
        // modules/local/tapes.nf). No official TAPES image exists either, and upstream
        // (a-xavier/tapes) doesn't work against current dbNSFP releases (renamed/removed
        // columns) -- this is our own fork (github.com/RomualdoMF/tapes,
        // fix/dbnsfp5-column-mapping branch) with those columns fixed, built from
        // docker/tapes/Dockerfile there. Self-contained (its ~140MB acmg_db reference data
        // ships inside the image), no bind mount needed. Same hardcoding rationale as
        // withLabel:annotsv above.
        container = "romualdomf/tapes:${params.wf.tapes_tag}"
    }
    withLabel:dmr_analysis {
        // DSS/bsseq DMR calling + bedtools annotation, adapted from
        // https://github.com/NyagaM/ont-methylDMR-kit (see modules/local/dmr.nf
        // and workflows/dmr.nf). Reuses that project's own published image
        // as-is (it already bundles R/DSS/bsseq + bedtools) rather than
        // building a new one -- same idea as reusing ensemblorg/ensembl-vep
        // directly for VEP above.
        container = "nyagam/ont-methyldmr-kit:${params.wf.dmr_analysis_tag}"
    }
    withLabel:dmr_report {
        // pandas/matplotlib HTML report (modules/local/dmr.nf::report_dmrs).
        // Not wf_common: wf_common doesn't have matplotlib (only used
        // elsewhere in this pipeline for pandas/pysam reporting), and this is
        // ont-methylDMR-kit's own report image anyway, reused as-is.
        container = "nyagam/seaborn:${params.wf.dmr_report_tag}"
    }
    withLabel:dmr_plot_modbamtools {
        container = "nyagam/modbamtools:${params.wf.modbamtools_tag}"
    }
    withLabel:dmr_plot_methylartist {
        container = "nyagam/methylartist:${params.wf.methylartist_tag}"
    }
    withLabel:wf_common {
        container = "ontresearch/wf-common:${params.wf.common_sha}"
    }
    withLabel:spectre {
        container = "ontresearch/spectre:${params.wf.spectre_tag}"
    }
    withLabel:longphase {
        container = "ontresearch/longphase:${params.wf.longphase_tag}"
    }

    shell = ['/bin/bash', '-euo', 'pipefail']

    // by default GPU tasks will run in serial to avoid GPU management.
    // cluster and cloud users can remove this with -profile discrete_gpus.
    // we use profiles to handle this as maxForks cannot be set dynamically
    // see https://github.com/nextflow-io/nextflow/discussions/3806 and CW-1857
    withLabel:gpu {
        maxForks = 1
    }
}


profiles {
    // the "standard" profile is used implicitely by nextflow
    // if no other profile is given on the CLI
    standard {
        docker {
            enabled = true
            // this ensures container is run as host user and group, but
            //    also adds host user to the within-container group
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
        process."withLabel:gpu".containerOptions = "--gpus all"
        // mount the VEP cache and plugins directories into the container at the
        // same absolute path they have on the host, so params.vep_cache_dir /
        // params.vep_plugins_dir (and any file path used in vep_custom_args /
        // vep_plugin_args under those directories) resolve identically inside
        // and outside the container.
        // NOTE: wrapped in a closure (like aws_image_prefix below) because
        // vep_cache_dir/vep_plugins_dir are declared in nextflow.config, which
        // is only fully parsed *after* this included base.config -- a plain
        // string here would interpolate too early and see them as null.
        process."withLabel:vep_annotation".containerOptions = \
            { "-v ${params.vep_cache_dir}:${params.vep_cache_dir} -v ${params.vep_plugins_dir}:${params.vep_plugins_dir}" }
        // same idea for AnnotSV's human annotation directory.
        process."withLabel:annotsv".containerOptions = \
            { "-v ${params.annotsv_annotations_dir}:${params.annotsv_annotations_dir}" }
        // same idea for the DMR gencode/imprinted annotation directory.
        process."withLabel:dmr_analysis".containerOptions = \
            { "-v ${params.dmr_annotations_dir}:${params.dmr_annotations_dir}" }
        // download_dmr_annotations (modules/local/dmr.nf) runs under wf_common, not
        // dmr_analysis (see the note there -- nyagam/ont-methyldmr-kit has no
        // curl/wget), so it needs this same bind mount too, or the mkdir-lock it does
        // against dmr_annotations_dir fails forever ("No such file or directory" ->
        // stuck in its own retry loop, since the directory doesn't exist inside the
        // container without this).
        process."withLabel:wf_common".containerOptions = \
            { "-v ${params.dmr_annotations_dir}:${params.dmr_annotations_dir}" }
    }

    // using singularity instead of docker
    singularity {
        singularity {
            enabled = true
            autoMounts = true
            //envWhitelist = "" // if your cluster sets a variable to indicate which GPU has been assigned you will want to allow it here
        }
        process."withLabel:gpu".containerOptions = "--nv"
        // same bind mounts as the docker/"standard" profile above, using
        // singularity's -B flag instead of docker's -v.
        process."withLabel:vep_annotation".containerOptions = \
            { "-B ${params.vep_cache_dir}:${params.vep_cache_dir} -B ${params.vep_plugins_dir}:${params.vep_plugins_dir}" }
        process."withLabel:annotsv".containerOptions = \
            { "-B ${params.annotsv_annotations_dir}:${params.annotsv_annotations_dir}" }
        process."withLabel:dmr_analysis".containerOptions = \
            { "-B ${params.dmr_annotations_dir}:${params.dmr_annotations_dir}" }
        // same reason as the docker/"standard" profile above.
        process."withLabel:wf_common".containerOptions = \
            { "-B ${params.dmr_annotations_dir}:${params.dmr_annotations_dir}" }
    }


    // keep stub conda profile to prevent unknown profile warning so users get a better error
    conda {
        conda {
            enabled = true
        }
    }

    // Using AWS batch.
    // May need to set aws.region and aws.batch.cliPath
    awsbatch {
        process {
            executor = 'awsbatch'
            queue = { "${params.aws_queue}" }
            memory = '8G'
            container = { "${params.aws_image_prefix}-wf-human-variation:${params.wf.e2l_base_tag}" }
            withLabel:wf_human_snp {
                container = { "${params.aws_image_prefix}-wf-human-variation-snp:${params.wf.e2l_snp_tag}" }
            }
            withLabel:wf_human_sv {
                container = { "${params.aws_image_prefix}-wf-human-variation-sv:${params.wf.e2l_sv_tag}" }
            }
            withLabel:wf_human_mod {
                container = { "${params.aws_image_prefix}-modkit:${params.wf.e2l_mod_tag}" }
            }
            withLabel:wf_cnv {
                container = { "${params.aws_image_prefix}-wf-cnv:${params.wf.cnv_tag}-root" }
            }
            withLabel:wf_human_str {
                container = { "${params.aws_image_prefix}-wf-human-variation-str:${params.wf.str_tag}" }
            }
            withLabel:vep_annotation {
                // ensembl-vep is a public third-party image (not mirrored under
                // aws_image_prefix like the other ontresearch/* images above)
                container = "ensemblorg/ensembl-vep:${params.wf.vep_tag}"
            }
            withLabel:annotsv {
                // same personal Docker Hub image as the standard/singularity
                // profiles above -- see the note there.
                container = "romualdomf/annotsv:${params.wf.annotsv_tag}"
            }
            withLabel:cnv_ensemble {
                container = "romualdomf/cnv-ensemble:${params.wf.cnv_ensemble_tag}"
            }
            withLabel:tldr {
                container = "romualdomf/tldr:${params.wf.tldr_tag}"
            }
            withLabel:tapes {
                container = "romualdomf/tapes:${params.wf.tapes_tag}"
            }
            withLabel:dmr_analysis {
                container = "nyagam/ont-methyldmr-kit:${params.wf.dmr_analysis_tag}"
            }
            withLabel:dmr_report {
                container = "nyagam/seaborn:${params.wf.dmr_report_tag}"
            }
            withLabel:dmr_plot_modbamtools {
                container = "nyagam/modbamtools:${params.wf.modbamtools_tag}"
            }
            withLabel:dmr_plot_methylartist {
                container = "nyagam/methylartist:${params.wf.methylartist_tag}"
            }
            withLabel:wf_common {
                container = "${params.aws_image_prefix}-wf-common:${params.wf.common_sha}"
            }
            withLabel:spectre {
                container = "${params.aws_image_prefix}-spectre:${params.wf.spectre_tag}"
            }
            withLabel:longphase {
                container = "${params.aws_image_prefix}-longphase:${params.wf.longphase_tag}"
            }
            shell = ['/bin/bash', '-euo', 'pipefail']
        }
    }

    // local profile for simplified development testing
    local {
        process.executor = 'local'
    }

    // lift limit on simultaneous gpu jobs
    discrete_gpus {
        process."withLabel:gpu".maxForks = null
    }

}


timeline {
  enabled = true
  file = "${params.out_dir}/execution/timeline.html"
  overwrite = true
}
report {
  enabled = true
  file = "${params.out_dir}/execution/report.html"
  overwrite = true
}
trace {
  enabled = true
  file = "${params.out_dir}/execution/trace.txt"
  overwrite = true
}

env {
    PYTHONNOUSERSITE = 1
    JAVA_TOOL_OPTIONS = "-Xlog:disable -Xlog:all=warning:stderr"
    RUST_BACKTRACE = 1
}
