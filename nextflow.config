// import profiles and workflow SHA from core
includeConfig "base.config"

// define workflow params
params {

    help = false
    version = false

    disable_ping = false
    threads = 4

    aws_image_prefix = null
    aws_queue = null

    // feature flags
    snp = false
    sv = false
    mod = false
    cnv = false
    str = false
    tldr = false

    // benchmark feature flags
    sv_benchmark = false
    sv_benchmark_vcf = null
    sv_benchmark_bed = null

    // common
    bam = null
    ref = null
    bed = null
    coverage_bed = null
    bam_min_coverage = 20
    downsample_coverage = false
    downsample_coverage_target = 60
    downsample_coverage_margin = 1.1
    depth_window_size = 25000
    haplocheck = false
    mitogenome = null
    igv = false
    alignment_report_coverage_threshold = 20

    /// common
    ubam_map_threads = 8
    ubam_sort_threads = 3
    ubam_bam2fq_threads = 1

    // annotation
    annotation = true

    // VEP (Ensembl Variant Effect Predictor) annotation, replaces SnpEff/SnpSift.
    // Cache and plugins directories are bind-mounted into the VEP container (see
    // base.config, withLabel:vep_annotation containerOptions). If the given
    // directories don't already contain the requested species/assembly/version,
    // the workflow downloads them automatically on first run (see modules/local/vep.nf)
    // and reuses them on subsequent runs.
    //
    // NOTE: defaults below point at data already present on this development
    // machine (/mnt/d/vep, /mnt/d/criteria_support_data) purely for convenience.
    // Other users cloning this repo should override them (e.g. via a fresh empty
    // vep_cache_dir/vep_plugins_dir, which will be populated automatically).
    vep_species = "homo_sapiens"
    vep_cache_version = 116
    vep_cache_dir = "/mnt/d/vep/vep_cache"
    vep_plugins_dir = "/mnt/d/vep/vep_cache/plugins"
    // which VEP plugins to install when vep_plugins_dir needs populating
    // ("all", "list", or a comma-separated plugin name list -- see VEP INSTALL.pl --PLUGINS)
    vep_install_plugins = "all"
    // extra VEP annotation sources, one entry per --custom / --plugin flag, e.g.:
    //   vep_custom_args = ["/mnt/d/vep/vep_cache/gnomad_v411.tsv.gz,gnomADg,vcf,exact,0,AF"]
    //   vep_plugin_args = ["AlphaMissense,file=/mnt/d/vep/vep_cache/AlphaMissense_hg38.tsv.gz"]
    // paths referenced here must live under vep_cache_dir or vep_plugins_dir (the
    // only host directories bind-mounted into the VEP container).
    vep_custom_args = []
    // dbNSFP5.3.1a (https://www.dbnsfp.org, GRCh38 build) via VEP's own bundled dbNSFP
    // plugin (installed automatically by vep_install_plugins = "all" above) -- NOT
    // --custom: dbNSFP is keyed by chr/pos/ref/alt/transcript, and only the dbNSFP plugin
    // (not a generic --custom tabix source) knows how to align that to each CSQ
    // transcript block correctly. The column list below is exactly what
    // src/vep_process.py in TAPES (see params.tapes / modules/local/tapes.nf) reads by
    // name off CSQ to compute ACMG PS3/PP5/BS3/BP6/PP3/BP4/PS4/PM2 -- add more dbNSFP
    // columns here (or 'ALL') if you need them for something else, but keep at least
    // these for TAPES to work. File path must live under vep_cache_dir (see note above);
    // dbNSFP5.3.1a_grch38.gz is expected there already downloaded+tabixed (dbNSFP has no
    // auto-download step here, unlike the VEP cache itself -- see
    // https://www.dbnsfp.org/download).
    vep_plugin_args = [
        "dbNSFP,${vep_cache_dir}/dbNSFP5.3.1a_grch38.gz,Interpro_domain,SIFT_score,MutationTaster_pred,MutationAssessor_pred,fathmm-XF_coding_pred,PROVEAN_score,MetaSVM_pred,MetaLR_pred,M-CAP_pred,GERP++_RS,clinvar_clnsig,clinvar_review,gnomAD4.1_joint_AF,gnomAD2.1.1_exomes_controls_AF"
    ]
    // any other raw VEP command-line flags, appended as-is
    vep_extra_args = ""

    // TAPES (https://github.com/RomualdoMF/tapes, fork of a-xavier/tapes patched for
    // dbNSFP5.x column compatibility) -- ACMG/AMP variant classification on top of the
    // VEP-annotated SNP VCF (needs --annotation, and the dbNSFP columns above to be
    // useful -- TAPES degrades gracefully with the plain VEP/ClinVar annotation alone,
    // but most ACMG criteria come from dbNSFP). Off by default; see
    // modules/local/tapes.nf and base.config withLabel:tapes.
    tapes = false

    // AnnotSV (https://github.com/lgmgeo/AnnotSV) -- structural variant
    // annotation/ranking, run on the VEP-annotated .wf_sv.vcf.gz. Off by
    // default: needs the container image built+pushed (see
    // docker/annotsv/Dockerfile and its withLabel:annotsv container in
    // base.config) and a large (~5GB) annotation download on first use.
    annotsv = false
    // human annotation data directory, bind-mounted into the AnnotSV container
    // (see base.config, withLabel:annotsv containerOptions). Downloaded
    // automatically on first run if empty (see modules/local/annotsv.nf) and
    // reused afterwards -- same idea as vep_cache_dir above.
    annotsv_annotations_dir = "/mnt/d/annotsv/annotations"
    annotsv_human_annotations_version = "3.5"
    // extra raw AnnotSV CLI flags, one list per SV type annotated (see
    // modules/local/annotsv.nf run_annotsv) -- e.g. ["-hpo", "HP:0001156"].
    // NOTE: AnnotSV's native `-vcf 1` output is currently broken (produces a
    // header-only VCF, no records -- see the note in modules/local/annotsv.nf),
    // so it's deliberately *not* in either default below.
    annotsv_sv_custom_args = []
    annotsv_cnv_custom_args = []

    // CNV classification ensemble: ISV (tsladecek/isv_package) + ClassifyCNV
    // (Genotek/ClassifyCNV), run on top of AnnotSV's .wf_cnv.annotsv.tsv (see
    // modules/local/cnv_ensemble.nf, bin/cnv_ensemble_classify.py). Off by
    // default; only meaningful when params.annotsv is also on, since it
    // consumes AnnotSV's output directly. Publishes <sample>.wf_cnv.annotated.tsv
    // (AnnotSV+ISV+ClassifyCNV columns merged) and <sample>.wf_cnv.annotated.vcf.gz
    // (same columns injected as INFO fields into the original .wf_cnv.vcf.gz)
    // to the usual output dir, same as the rest of the CNV outputs.
    cnv_ensemble = false

    // snp
    override_basecaller_cfg = null
    clair3_model_path = null // used for overriding the guessed clair3 model
    // clair3 parameters
    sample_name = null
    ctg_name = null
    include_all_ctgs = false
    ref_pct_full = 0.1
    var_pct_full = 0.7
    GVCF = false
    base_err = 0.001
    gq_bin_size = 5
    snp_min_af = 0.08
    indel_min_af = 0.15
    vcf_fn = null
    min_contig_size = 0
    min_mq = 5
    min_cov = 2
    min_qual = 2
    refine_snp_with_sv = true

    // sv
    tr_bed= null
    // filterCalls
    min_sv_length = 30
    min_read_support = "auto"
    min_read_support_limit = 2
    // sniffles2 options
    cluster_merge_pos = 150
    sniffles_args = null

    // qdnaseq cnv
    use_qdnaseq = false
    qdnaseq_bin_size = 500

    // spectre cnv
    spectre_args = null

    // mod
    modkit_args = null
    force_strand = false
    modkit_threads = 4

    // DMR (Differentially Methylated Region) calling, via ont-methylDMR-kit's
    // DSS/bsseq core (https://github.com/NyagaM/ont-methylDMR-kit, commit
    // dcbc3da31db19f477194cdd33ebc3001554f888e -- see workflows/dmr.nf /
    // modules/local/dmr.nf). Both opt-in, off by default, and both require
    // params.mod. Runs DSS for 5mC and 5hmC (whatever workflows/methyl.nf's own
    // modkit invocation produces).
    //
    // Haplotype 1 vs haplotype 2 of the same sample -- only meaningful with
    // --phased (needs H1/H2 bedmethyl).
    dmr_haplotype_compare = false
    // The sample vs an external reference: a BAM/CRAM (piled up here) or an
    // already-built bedmethyl -- detected by file extension (see
    // workflows/dmr.nf::dmr_sample_compare).
    dmr_sample_compare = false
    dmr_sample_compare_reference = null
    // Literal subset of upstream ont-methylDMR-kit's own CLI flags this
    // integration understands, one list per comparison. Annotation
    // (gencode/imprinted) and the HTML report always run once DMRs are called
    // (same as upstream -- they aren't optional there either); only plotting is
    // gated by these. Default includes "--plot" (full pipeline, as requested):
    // pass a shorter/empty list to skip plotting for that comparison.
    // Recognised flags: --plot, --methylartist_only, --gene_list <path>, --imprinted.
    dmr_haplotype_compare_args = ["--plot"]
    dmr_sample_compare_args = ["--plot"]
    // gencode v46 promoter/exon/intron BED + imprinted gene list + gencode GTF
    // (for plotting), downloaded once from the pinned ont-methylDMR-kit commit
    // above into this directory (idempotent, same pattern as
    // vep_cache_dir/annotsv_annotations_dir -- see download_dmr_annotations in
    // modules/local/dmr.nf).
    dmr_annotations_dir = "/mnt/d/dmr_annotations"

    //str
    sex = null
    // STR (Short Tandem Repeat) genotyping: straglr genotypes the loci listed
    // in str_repeat_bed, then Stranger annotates the resulting VCF against
    // str_variant_catalog (see modules/local/wf-human-str.nf). Defaults point
    // at STRchive's (https://github.com/dashnowlab/STRchive) pre-built hg38
    // catalogs -- a straglr-format BED and a Stranger-format JSON, both
    // published by STRchive itself as schema-compatible drop-ins for these
    // exact tools -- replacing the small 52-locus GeneReviews-only catalog
    // wf-human-variation originally shipped (data/wf_str_repeats.bed /
    // data/variant_catalog_hg38.json, left in the repo for reference but no
    // longer used by default). Override both to point at your own BED/JSON
    // to use a different catalog.
    str_repeat_bed = "${projectDir}/data/STRchive-disease-loci.hg38.straglr.bed"
    str_variant_catalog = "${projectDir}/data/STRchive-disease-loci.hg38.stranger.json"

    // tldr (https://github.com/adamewing/tldr) -- identifies and annotates
    // transposable-element-mediated insertions in long-read alignments.
    // Runs per-contig against the same intermediate haplotagged BAMs
    // straglr already consumes (see workflows/wf-human-snp.nf, the
    // `str_bams` emit -- per-contig, produced before the final whole-genome
    // BAM merge), one tldr invocation per contig (modules/local/tldr.nf),
    // merged into a single <alias>.wf_tldr.table.txt at the end. Requires
    // haplotagging, same as --str: turning --tldr on by itself is enough to
    // trigger it (see main.nf, run_haplotagging), no need to also pass
    // --phased.
    //
    // One param per tldr CLI option, except:
    //   -b/--bams, -r/--ref, -o/--outbase, -c/--chroms
    // which are NOT exposed -- they're wired internally by the pipeline
    // (the per-contig BAM channel, params.ref, a deterministic
    // "<alias>.<contig>" basename needed for merge_tldr to concatenate the
    // per-contig tables afterwards, and the fact that each per-contig BAM
    // already contains only that one contig's reads, making --chroms a
    // no-op here).
    //
    // -e/--elts and -n/--nonref default to the human reference data already
    // bundled *inside* the tldr image itself (docker/tldr/Dockerfile,
    // $TLDR_REF_DIR=/opt/tldr/ref) -- no external download needed, unlike
    // VEP's cache or AnnotSV's annotations (a few hundred KB - ~1MB per
    // file, vs. multi-GB there). They're plain strings, not Nextflow `path`
    // params: the defaults live inside the container image rather than on
    // the host filesystem, so declaring them as `path` inputs would make
    // Nextflow try (and fail) to stage them from the host before the
    // container ever starts. Overriding either with your own file requires
    // it to already be reachable inside the tldr container -- there's no
    // bind-mounted data directory for tldr (unlike vep_cache_dir /
    // annotsv_annotations_dir), since the bundled files are small enough
    // not to need one.
    tldr_elts = "/opt/tldr/ref/teref.ont.human.fa"
    // known non-reference (polymorphic) insertion sites, for annotation.
    // Bundled default is hg38 with "chr"-prefixed contigs, matching this
    // pipeline's usual reference naming -- override to
    // "/opt/tldr/ref/nonref.collection.hg19.chr.bed.gz" for a hg19
    // reference, or set to null/false to disable -n entirely.
    tldr_nonref = "/opt/tldr/ref/nonref.collection.hg38.chr.bed.gz"
    // also used as the process's cpus (tldr's own -p is python
    // multiprocessing within a single contig's invocation).
    tldr_procs = 4
    tldr_minreads = 3
    tldr_embed_minreads = 1
    tldr_max_te_len = 10000
    tldr_min_te_len = 200
    tldr_min_alt_frac = 0.5
    tldr_min_alt_depth = 3
    tldr_min_total_depth_frac = 0.25
    // null = no limit (tldr's own default)
    tldr_max_cluster_size = null
    tldr_wiggle = 50
    tldr_flanksize = 500
    // NOTE: enabling this embeds ANSI colour escape codes directly in the
    // consensus sequence column of the output table -- fine to look at with
    // e.g. `less -R`, but will corrupt naive parsing of that column.
    tldr_color_consensus = false
    tldr_detail_output = false
    tldr_extend_consensus = 0
    tldr_trdcol = false
    tldr_keep_pickles = false
    // path to a folder of .pickle files from a previous run with
    // tldr_keep_pickles enabled; null = build clusters from scratch
    tldr_use_pickles = null

    // output
    depth_intervals = false
    phased = false
    output_report = true
    output_xam_fmt = "cram"

    // Integrations
    partner = null

    // nfcore
    monochrome_logs = false
    validate_params = true
    show_hidden_params = false
    schema_ignore_params = 'show_hidden_params,validate_params,monochrome_logs,aws_queue,aws_image_prefix,wf,min_read_support,min_read_support_limit,fastq_only'

    store_dir = null

    wf {
        name = "wf-human-variation"
        template_version = "195cab5"
        example_cmd = [
            "--bam 'wf-human-variation-demo/demo.bam'",
            "--ref 'wf-human-variation-demo/demo.fasta'",
            "--bed 'wf-human-variation-demo/demo.bed'",
            "--sample_name 'DEMO'",
            "--snp",
            "--sv",
            "--mod",
            "--phased"
        ]
        agent = null
    }
}

// this process is inherited from wf-template, which specifies not many CPUs as a conservative baseline.
process {
    withName:mergeBams {
        cpus = 8
    }
}

manifest {
    name            = 'epi2me-labs/wf-human-variation'
    author          = 'Oxford Nanopore Technologies'
    homePage        = 'https://github.com/epi2me-labs/wf-human-variation'
    description     = 'SNV calling, SV calling, modified base calling, CNV calling, and STR genotyping of human samples.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.2'
    version         = '2.8.1'
}

epi2melabs {
    tags = "wf-human-variation,variant calling,whole genome,human"
    icon = "faIdCard"
}

